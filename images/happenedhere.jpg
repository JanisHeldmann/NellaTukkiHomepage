<svg width="100%" viewBox="0 0 690 970" role="img" xmlns="http://www.w3.org/2000/svg" style="">
  <title style="fill:rgb(0, 0, 0);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto">Happened Here Today — performance poster</title>
  <desc style="fill:rgb(0, 0, 0);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto">A dark atmospheric poster for the performance Happened Here Today, Maputo, Mozambique 2011</desc>

  <defs>
    <clipPath id="clip">
      <rect width="680" height="960"/>
    </clipPath>
  </defs>

  <!-- Background — deep night earth -->
  <rect width="680" height="960" fill="#0e0c08" style="fill:rgb(14, 12, 8);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>

  <!-- Subtle ground plane lines -->
  <line x1="0" y1="640" x2="680" y2="640" stroke="#1e1c14" stroke-width="0.5" style="fill:rgb(0, 0, 0);stroke:rgb(30, 28, 20);color:rgb(255, 255, 255);stroke-width:0.5px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>
  <line x1="0" y1="680" x2="680" y2="680" stroke="#1a1810" stroke-width="0.5" style="fill:rgb(0, 0, 0);stroke:rgb(26, 24, 16);color:rgb(255, 255, 255);stroke-width:0.5px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>
  <line x1="0" y1="720" x2="680" y2="720" stroke="#161410" stroke-width="0.5" style="fill:rgb(0, 0, 0);stroke:rgb(22, 20, 16);color:rgb(255, 255, 255);stroke-width:0.5px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>

  <!-- Horizon glow — deep amber, very faint -->
  <rect x="0" y="540" width="680" height="120" fill="#2a1e08" opacity="0.6" style="fill:rgb(42, 30, 8);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:0.6;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>
  <rect x="0" y="580" width="680" height="60" fill="#1e1508" opacity="0.5" style="fill:rgb(30, 21, 8);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:0.5;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>

  <!-- Abstract figure silhouette — body -->
  <ellipse cx="340" cy="490" rx="28" ry="38" fill="#0a0804" style="fill:rgb(10, 8, 4);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>
  <!-- Head -->
  <circle cx="340" cy="438" r="20" fill="#0a0804" style="fill:rgb(10, 8, 4);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>
  <!-- Arms reaching outward -->
  <path d="M314 478 C290 468, 260 472, 230 462" stroke="#0a0804" stroke-width="14" fill="none" stroke-linecap="round" style="fill:none;stroke:rgb(10, 8, 4);color:rgb(255, 255, 255);stroke-width:14px;stroke-linecap:round;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>
  <path d="M366 478 C390 468, 420 472, 450 462" stroke="#0a0804" stroke-width="14" fill="none" stroke-linecap="round" style="fill:none;stroke:rgb(10, 8, 4);color:rgb(255, 255, 255);stroke-width:14px;stroke-linecap:round;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>
  <!-- Legs -->
  <path d="M328 526 C322 560, 315 600, 308 640" stroke="#0a0804" stroke-width="13" fill="none" stroke-linecap="round" style="fill:none;stroke:rgb(10, 8, 4);color:rgb(255, 255, 255);stroke-width:13px;stroke-linecap:round;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>
  <path d="M352 526 C358 560, 365 600, 372 640" stroke="#0a0804" stroke-width="13" fill="none" stroke-linecap="round" style="fill:none;stroke:rgb(10, 8, 4);color:rgb(255, 255, 255);stroke-width:13px;stroke-linecap:round;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>

  <!-- Shadow on ground -->
  <ellipse cx="340" cy="645" rx="55" ry="8" fill="#1a1408" opacity="0.8" style="fill:rgb(26, 20, 8);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:0.8;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>

  <!-- Decorative horizontal rule top -->
  <line x1="60" y1="80" x2="620" y2="80" stroke="#4a3e20" stroke-width="0.5" style="fill:rgb(0, 0, 0);stroke:rgb(74, 62, 32);color:rgb(255, 255, 255);stroke-width:0.5px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>

  <!-- Top label -->
  <text x="340" y="68" text-anchor="middle" font-family="Georgia, serif" font-size="11" fill="#6b5830" letter-spacing="4" style="fill:rgb(107, 88, 48);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:Georgia, serif;font-size:11px;font-weight:400;text-anchor:middle;dominant-baseline:auto">NELLA TURKKI</text>

  <!-- Main title — large, split across lines -->
  <text x="340" y="200" text-anchor="middle" font-family="Georgia, serif" font-size="72" font-weight="300" fill="#e8dcc0" letter-spacing="-1" style="fill:rgb(232, 220, 192);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:Georgia, serif;font-size:72px;font-weight:300;text-anchor:middle;dominant-baseline:auto">HAPPENED</text>
  <text x="340" y="278" text-anchor="middle" font-family="Georgia, serif" font-size="72" font-weight="300" fill="#e8dcc0" letter-spacing="-1" style="fill:rgb(232, 220, 192);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:Georgia, serif;font-size:72px;font-weight:300;text-anchor:middle;dominant-baseline:auto">HERE</text>
  <text x="340" y="356" text-anchor="middle" font-family="Georgia, serif" font-size="72" font-weight="300" fill="#e8dcc0" letter-spacing="-1" style="fill:rgb(232, 220, 192);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:Georgia, serif;font-size:72px;font-weight:300;text-anchor:middle;dominant-baseline:auto">TODAY</text>

  <!-- Thin rule under title -->
  <line x1="180" y1="378" x2="500" y2="378" stroke="#4a3e20" stroke-width="0.5" style="fill:rgb(0, 0, 0);stroke:rgb(74, 62, 32);color:rgb(255, 255, 255);stroke-width:0.5px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>

  <!-- Subtitle / context -->
  <text x="340" y="404" text-anchor="middle" font-family="Georgia, serif" font-size="13" font-style="italic" fill="#7a6840" style="fill:rgb(122, 104, 64);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:Georgia, serif;font-size:13px;font-weight:400;font-style:italic;text-anchor:middle;dominant-baseline:auto">Eduardo Mondlane University Theatre Department</text>
  <text x="340" y="422" text-anchor="middle" font-family="Georgia, serif" font-size="13" font-style="italic" fill="#5a4e30" style="fill:rgb(90, 78, 48);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:Georgia, serif;font-size:13px;font-weight:400;font-style:italic;text-anchor:middle;dominant-baseline:auto">Maputo, Mozambique</text>

  <!-- Bottom rule -->
  <line x1="60" y1="870" x2="620" y2="870" stroke="#4a3e20" stroke-width="0.5" style="fill:rgb(0, 0, 0);stroke:rgb(74, 62, 32);color:rgb(255, 255, 255);stroke-width:0.5px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>

  <!-- Year -->
  <text x="340" y="896" text-anchor="middle" font-family="Georgia, serif" font-size="13" fill="#6b5830" letter-spacing="6" style="fill:rgb(107, 88, 48);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:Georgia, serif;font-size:13px;font-weight:400;text-anchor:middle;dominant-baseline:auto">2011</text>

  <!-- Small decorative marks -->
  <circle cx="340" cy="140" r="2" fill="#4a3e20" style="fill:rgb(74, 62, 32);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>
  <circle cx="320" cy="140" r="1" fill="#3a2e14" style="fill:rgb(58, 46, 20);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>
  <circle cx="360" cy="140" r="1" fill="#3a2e14" style="fill:rgb(58, 46, 20);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>

</svg>
